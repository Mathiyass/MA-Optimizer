# ==============================================================================
# Token Optimization: Ignore massive lockfiles, builds, caches & generated files
# ==============================================================================

# Package Lockfiles (30k+ lines, major token drains)
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
bun.lock
Cargo.lock
Gemfile.lock
poetry.lock
composer.lock
flake.lock
*.lock

