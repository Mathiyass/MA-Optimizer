{
  "name": "ma-optimizer",
  "version": "7.1.0",
  "description": "MA-Optimizer — The Ultimate Windows System Optimizer",
  "author": "Mathisha Angirasa",
  "homepage": "https://mathiyass.github.io/MAportfolio/",
  "repository": "https://github.com/Mathiyass/MA-Optimizer",
  "license": "MIT",
  "main": "electron/dist/main.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "build:win": "npm run dist:installer",
    "build:portable": "npm run dist:portable",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dist:all": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src electron --ext .ts,.tsx",
    "electron:dev": "npm run dev",
    "electron:build": "npm run dist:installer",
    "test": "node --experimental-strip-types --test src/utils/health.test.ts"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.7",
    "systeminformation": "^5.22.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.45.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/winston": "^2.4.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.395.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-circular-progressbar": "^2.1.0",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.4",
    "terser": "^5.46.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.2"
  },
  "build": {
    "appId": "com.maoptimizer.app",
    "productName": "MA-Optimizer",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "warningsAsErrors": false
    },
    "portable": {
      "requestExecutionLevel": "admin"
    }
  }
}