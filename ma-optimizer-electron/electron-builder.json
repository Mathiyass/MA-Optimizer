{
    "appId": "com.mathiyass.ma-optimizer",
    "productName": "MA-Optimizer",
    "copyright": "Copyright © 2026 Mathisha Angirasa",
    "directories": {
        "output": "release",
        "buildResources": "public"
    },
    "files": [
        "dist-vite/**/*",
        "electron/dist/**/*"
    ],
    "extraResources": [
        {
            "from": "public",
            "to": "public",
            "filter": [
                "**/*"
            ]
        }
    ],
    "win": {
        "target": [
            {
                "target": "portable",
                "arch": [
                    "x64"
                ]
            },
            {
                "target": "nsis",
                "arch": [
                    "x64"
                ]
            }
        ],
        "icon": "public/icon.ico",
        "requestedExecutionLevel": "requireAdministrator",
        "signAndEditExecutable": false
    },
    "portable": {
        "artifactName": "MA-Optimizer-v${version}-portable.exe",
        "requestExecutionLevel": "admin",
        "unpackDirName": "MA-Optimizer"
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "perMachine": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "MA-Optimizer",
        "artifactName": "MA-Optimizer-Setup.exe",
        "deleteAppDataOnUninstall": false,
        "runAfterFinish": true
    },
    "publish": {
        "provider": "github",
        "owner": "Mathiyass",
        "repo": "MA-Optimizer",
        "releaseType": "release"
    }
}