 function formatBytes(b: number) {
     if (!b) return '0 B'
     const k = 1024, s = ['B', 'KB', 'MB', 'GB', 'TB']
     const i = Math.floor(Math.log(Math.abs(b) || 1) / Math.log(k))
     return (b / Math.pow(k, i)).toFixed(1) + ' ' + s[i]
